#!/bin/bash
# Pre-commit security gate — blocks commits containing sensitive data
# Install: git config core.hooksPath .githooks

echo "Running security gate..."

BLOCKED=0

# Check staged files for passwords, API keys, tokens
PATTERNS=(
    'sk-ant-api'
    'ANTHROPIC_API_KEY=sk-'
    'INDUSTRY_ADMIN_SECRET=.'
    '"password":\s*"[a-z]+-[a-z]+-[a-z0-9]+'
    'passwordHash.*=.*"[^$]'
)

for pattern in "${PATTERNS[@]}"; do
    MATCHES=$(git diff --cached --diff-filter=ACM -S "$pattern" --name-only 2>/dev/null | grep -v '.githooks/' | grep -v 'test_privacy')
    if [ -n "$MATCHES" ]; then
        echo "BLOCKED: Pattern '$pattern' found in staged files:"
        echo "$MATCHES"
        BLOCKED=1
    fi
done

# Check for large personal data files
LARGE_FILES=$(git diff --cached --diff-filter=ACM --name-only | while read f; do
    SIZE=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
    if [ "$SIZE" -gt 100000 ]; then
        echo "  $f ($SIZE bytes)"
    fi
done)

if [ -n "$LARGE_FILES" ]; then
    echo "WARNING: Large files staged (>100KB):"
    echo "$LARGE_FILES"
    echo "Verify no personal data is included."
fi

# Check for identity model content in test files
# The pattern list lives OUTSIDE this repository, in .git/info/pii-patterns, one regex per
# line. Enumerating the terms here published the exact categories the hook exists to catch,
# in a public file, which defeats the point of having it.
#
# Also: this used `git diff -S`, which takes a FIXED STRING unless --pickaxe-regex is passed.
# It therefore searched for the literal escaped-alternation text and matched nothing, ever,
# across 133 commits. A hook that has never rejected anything is not evidence of clean commits.
# --git-common-dir, not --git-dir. In a worktree the latter returns the worktree's own
# directory, so the patterns written to the shared info/ would never be found and the hook
# would silently pass. Found by testing the hook against a known-bad input.
PII_PATTERNS_FILE="$(git rev-parse --git-common-dir)/info/pii-patterns"
IDENTITY_IN_TESTS=""
if [ -f "$PII_PATTERNS_FILE" ]; then
  while IFS= read -r pat; do
    [ -z "$pat" ] && continue
    case "$pat" in \#*) continue ;; esac
    HIT=$(git diff --cached --diff-filter=ACM --pickaxe-regex -S "$pat" -- tests/ 2>/dev/null)
    [ -n "$HIT" ] && IDENTITY_IN_TESTS="$IDENTITY_IN_TESTS$HIT"
  done < "$PII_PATTERNS_FILE"
fi
if [ -n "$IDENTITY_IN_TESTS" ]; then
    echo "BLOCKED: Personal identity content found in test files"
    BLOCKED=1
fi

if [ "$BLOCKED" -eq 1 ]; then
    echo ""
    echo "Commit blocked by security gate. Fix the issues above."
    echo "To bypass (NOT recommended): git commit --no-verify"
    exit 1
fi

echo "Security gate passed."
